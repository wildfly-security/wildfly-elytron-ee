    <profiles>
        <profile>
            <id>aggregate-javadoc</id>
            <activation>
                <property>
                    <name>aggregate-javadoc</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <notimestamp>true</notimestamp>
                            <doclint>none</doclint>
                            <show>protected</show>
                            <sourcepath>
                                ${project.basedir}/authentication/src/main/java/;
                                ${project.basedir}/authorization/src/main/java/;
                                ${project.basedir}/client/resteasy/src/main/java/;
                                ${project.basedir}/client/webservices/src/main/java/;
                            </sourcepath>
                            <sourceFileExcludes>
                                <exclude>org/wildfly/security/manager/JDKSpecific.java</exclude>
                            </sourceFileExcludes>
                        </configuration>
                        <executions>
                            <execution><!-- mvn -Paggregate-javadoc javadoc:aggregate@api-javadoc -->
                                <id>api-javadoc</id>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                                <configuration>
                                    <destDir>api-javadoc</destDir>
                                    <sourceFileIncludes>
                                        <include>org/wildfly/security/auth/jaspi/*.java</include>
                                    </sourceFileIncludes>
                                </configuration>
                            </execution>
                            <execution><!-- mvn -Paggregate-javadoc javadoc:aggregate@full-javadoc -->
                                <id>full-javadoc</id>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                                <configuration>
                                    <destDir>full-javadoc</destDir>
                                    <show>private</show>
                                    <sourceFileIncludes>
                                        <include>**\/\*.java</include>
                                    </sourceFileIncludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for multi-version testing using Maven Toolchains -->
        <!-- Activated when jdk.test.version property is set -->
        <!-- Usage: mvn test -Djdk.test.version=17 -->
        <!-- Optional: mvn test -Djdk.test.version=17 -Djdk.test.vendor=semeru -->
        <profile>
            <id>toolchain-test</id>
            <activation>
                <property>
                    <name>jdk.test.version</name>
                </property>
            </activation>
            <properties>
                <!-- Default to Temurin if vendor not specified -->
                <jdk.test.vendor>temurin</jdk.test.vendor>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <jdkToolchain>
                                <version>${jdk.test.version}</version>
                                <vendor>${jdk.test.vendor}</vendor>
                            </jdkToolchain>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile for comprehensive multi-version testing -->
        <!-- Tests with Java 17, 21, and 25 sequentially -->
        <!-- Usage: mvn install -Ptest-all-versions -->
        <!-- Optional: mvn install -Ptest-all-versions -Djdk.test.vendor=semeru -->
        <profile>
            <id>test-all-versions</id>
            <properties>
                <!-- Default to Temurin if vendor not specified -->
                <jdk.test.vendor>temurin</jdk.test.vendor>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <!-- Test with Java 17 -->
                            <execution>
                                <id>test-java-17</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <jdkToolchain>
                                        <version>17</version>
                                        <vendor>${jdk.test.vendor}</vendor>
                                    </jdkToolchain>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-java17-${jdk.test.vendor}</reportsDirectory>
                                </configuration>
                            </execution>

                            <!-- Test with Java 21 -->
                            <execution>
                                <id>test-java-21</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <jdkToolchain>
                                        <version>21</version>
                                        <vendor>${jdk.test.vendor}</vendor>
                                    </jdkToolchain>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-java21-${jdk.test.vendor}</reportsDirectory>
                                </configuration>
                            </execution>

                            <!-- Test with Java 25 -->
                            <execution>
                                <id>test-java-25</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <jdkToolchain>
                                        <version>25</version>
                                        <vendor>${jdk.test.vendor}</vendor>
                                    </jdkToolchain>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-java25-${jdk.test.vendor}</reportsDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
